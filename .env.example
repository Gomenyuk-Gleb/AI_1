# Cloud model in LiteLLM format, e.g. gemini/gemini-flash-latest, openai/gpt-4o-mini, anthropic/claude-haiku-4-5
CLOUD_MODEL=gemini/gemini-flash-latest
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local model served by Ollama (must be pulled first: `ollama pull llama3.2:3b`)
LOCAL_MODEL=ollama/llama3.2:3b
OLLAMA_API_BASE=http://localhost:11434

# Safety limits
COST_LIMIT_USD=4
REQUEST_TIMEOUT_S=30
MAX_RETRIES=3
